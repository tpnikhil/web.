<!DOCTYPE html>
<html>
<head>
<title>Travel Booking Website</title>

<style>
body {
    font-family: Arial;
    background: #f2f6fa;
    margin: 0;
}

header {
    background: navy;
    color: white;
    text-align: center;
    padding: 20px;
}

nav {
    background: #222;
    padding: 15px;
    text-align: center;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 15px;
}

h2 {
    color: navy;
    text-align: center;
}

.booking {
    background: white;
    width: 80%;
    margin: 25px auto;
    padding: 20px;
    border-radius: 10px;
}

input, select {
    padding: 10px;
    margin: 8px;
    width: 90%;
    border: 1px solid #aaa;
    border-radius: 5px;
}

button {
    background: navy;
    color: white;
    padding: 12px 20px;
    border: none;
    cursor: pointer;
    border-radius: 5px;
}

.services {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
}

.card {
    background: white;
    width: 200px;
    margin: 15px;
    padding: 15px;
    text-align: center;
    border-radius: 10px;
}

table {
    width: 85%;
    margin: auto;
    border-collapse: collapse;
    background: white;
}

th, td {
    border: 1px solid #aaa;
    padding: 12px;
    text-align: center;
}

th {
    background: navy;
    color: white;
}

.seats {
    display: grid;
    grid-template-columns: repeat(4, 45px);
    gap: 10px;
    justify-content: center;
    margin: 20px;
}

.seats button {
    background: green;
    padding: 10px;
}

.seats button.selected {
    background: orange;
}

footer {
    background: navy;
    color: white;
    text-align: center;
    padding: 15px;
    margin-top: 30px;
}

@media(max-width:600px) {
    .booking {
        width: 90%;
    }

    nav a {
        display: inline-block;
        margin: 6px;
    }

    table {
        font-size: 12px;
    }
}
</style>
</head>

<body>

<header>
<h1>Travel Booking</h1>
<p>Book Your Journey Easily</p>
</header>

<nav>
<a href="#home">Home</a>
<a href="#booking">Booking</a>
<a href="#services">Services</a>
<a href="#seats">Seats</a>
<a href="#fare">Fare</a>
</nav>

<h2 id="home">Welcome to Travel Booking</h2>
<p align="center">Plan your trip and enjoy your journey.</p>

<h2 id="booking">Book Your Ticket</h2>

<div class="booking">
<form onsubmit="bookTicket(event)">

<label>Source:</label>
<input type="text" id="source" placeholder="Enter source city" required>

<label>Destination:</label>
<input type="text" id="destination" placeholder="Enter destination city" required>

<label>Travel Date:</label>
<input type="date" id="date" required>

<label>Passengers:</label>
<input type="number" id="passengers" min="1" max="6" value="1" required>

<label>Passenger Name:</label>
<input type="text" placeholder="Enter passenger name" required>

<label>Travel Type:</label>
<select>
<option>Bus</option>
<option>Train</option>
<option>Flight</option>
</select>

<br><br>
<button type="submit">Search Tickets</button>
</form>
<p id="message"></p>
</div>

<h2 id="services">Available Services</h2>

<div class="services">

<div class="card">
<h3>Bus</h3>
<p>Comfortable Bus Travel</p>
<p>₹800</p>
</div>

<div class="card">
<h3>Train</h3>
<p>Safe Train Journey</p>
<p>₹500</p>
</div>

<div class="card">
<h3>Flight</h3>
<p>Fast Air Travel</p>
<p>₹3500</p>
</div>

</div>

<h2 id="seats">Select Your Seat</h2>

<div class="seats">
<button onclick="selectSeat(this)">1</button>
<button onclick="selectSeat(this)">2</button>
<button onclick="selectSeat(this)">3</button>
<button onclick="selectSeat(this)">4</button>

<button onclick="selectSeat(this)">5</button>
<button onclick="selectSeat(this)">6</button>
<button onclick="selectSeat(this)">7</button>
<button onclick="selectSeat(this)">8</button>

<button onclick="selectSeat(this)">9</button>
<button onclick="selectSeat(this)">10</button>
<button onclick="selectSeat(this)">11</button>
<button onclick="selectSeat(this)">12</button>
</div>

<p align="center">Green = Available | Orange = Selected</p>

<h2 id="fare">Fare Information</h2>

<table>
<tr>
<th>Travel Type</th>
<th>Fare</th>
<th>Service</th>
</tr>

<tr>
<td>Bus</td>
<td>₹800</td>
<td>AC Bus</td>
</tr>

<tr>
<td>Train</td>
<td>₹500</td>
<td>Express Train</td>
</tr>

<tr>
<td>Flight</td>
<td>₹3500</td>
<td>Economy Class</td>
</tr>
</table>

<footer>
<h3>Travel Booking Website</h3>
<p>Thank You for Choosing Us!</p>
<p>© 2026 Travel Booking</p>
</footer>

<script>
function selectSeat(button) {
    button.classList.toggle("selected");
}

function bookTicket(event) {
    event.preventDefault();

    let source = document.getElementById("source").value;
    let destination = document.getElementById("destination").value;

    document.getElementById("message").innerHTML =
        "Journey from " + source + " to " + destination +
        " details submitted successfully!";
}
</script>

</body>
</html>